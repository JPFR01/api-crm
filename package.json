{
    "name": "api-image-app",
    "version": "0.0.1",
    "description": "",
    "main": "dist/main/server.js",
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.build.json && tscpaths -p tsconfig.json -s ./src -o ./dist && node scripts/copy-assets.js",
        "build-dev": "rimraf dist && tsc -p tsconfig.build.json && tscpaths -p tsconfig.json -s ./src -o ./dist && node scripts/copy-assets.js",
        "copy-files": "node scripts/copy-assets.js",
        "test": "NODE_ENV=test jest --no-cache --watchAll --coverage",
        "dev": "ts-node-dev -r tsconfig-paths/register -r dotenv/config --respawn --transpile-only --ignore-watch node_modules --no-notify src/main/server.ts",
        "start": "node ./dist/main/server.js",
        "start:dev": "node dist/main/server.js",
        "analyze:audit": "yarn check-vulnerabilities && yarn lint && yarn build && yarn sonar",
        "analyze": "yarn lint && yarn build && yarn check-vulnerabilities",
        "update-version": "node -e \"const fs = require('fs'); fs.writeFileSync('VERSION', process.env.npm_package_version)\"",
        "release": "standard-version  && yarn update-version",
        "release:patch": "standard-version --release-as patch && yarn update-version",
        "release:beta": "standard-version --prerelease beta && yarn update-version",
        "release:minor": "standard-version --release-as minor  && yarn update-version",
        "release:major": "standard-version --release-as major  && yarn update-version",
        "lint": "eslint --ext .ts src && tsc --noEmit",
        "lint:fix": "eslint --ext .ts src/ --fix",
        "format": "prettier --write 'src/**/*.{js,ts,json}' --config ./.prettierrc",
        "prepare": "husky",
        "check-vulnerabilities": "yarn audit --level critical | grep -q 'found 0 vulnerabilities' && echo 'No critical vulnerabilities found.' || echo 'Critical vulnerabilities found. Please fix them before pushing.'"
    },
    "author": "João Pedro Fonseca Rodrigues",
    "license": "ISC",
    "devDependencies": {
        "@types/axios": "^0.14.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.10",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.9.2",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/typescript": "^2.0.0",
        "@types/yamljs": "^0.2.34",
        "@typescript-eslint/eslint-plugin": "^6.11.0",
        "@typescript-eslint/parser": "^6.11.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.3",
        "jest": "^29.7.0",
        "jest-mock": "^29.7.0",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.2",
        "ts-jest": "^29.1.1",
        "typescript": "^5.2.2",
        "yarn": "^1.22.21"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.95.3",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/uuid": "^10.0.0",
        "applicationinsights": "^2.9.5",
        "axios": "^1.11.0",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "express-list-endpoints": "^7.1.1",
        "fast-xml-parser": "^4.4.1",
        "husky": "^9.0.11",
        "js-sha512": "^0.8.0",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^3.1.0",
        "path": "^0.12.7",
        "standard-version": "^9.5.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^3.14.2",
        "tscpaths": "^0.0.9",
        "uuid": "^11.0.5",
        "winston": "^3.13.0",
        "winston-azure-application-insights": "^4.0.0",
        "yamljs": "^0.3.0"
    }
}